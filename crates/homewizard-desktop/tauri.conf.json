{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HWTray",
  "identifier": "com.homewizard-unofficial.desktop",
  "version": "0.1.4",
  "build": {
    "beforeBuildCommand": "mise run build:front",
    "beforeDevCommand": "mise run dev:front",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    },
    "windows": [],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.png"
    ],
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyODQ2QjYyQTJFRENDMDQKUldRRXpPMmlZbXVFSWtHK3pGc0lNbysxSVZSd3lvVTE5Nnk1dVk2MjZtMEdVY3VQak9lcVRxMWUK",
      "endpoints": [
        "https://github.com/eduardostuart/hwtray/releases/latest/download/latest.json"
      ]
    }
  }
}
